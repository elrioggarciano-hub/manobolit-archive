// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model LiteratureEntry {
  id                String   @id @default(cuid())
  title             String
  manoboTitle       String?
  englishTitle      String?
  type              String   // "ORAL_LITERATURE" | "FOLK_SONG"
  content           String
  transcription     String?
  translation       String?
  bisayaTranslation String?
  audioFile         String?
  audioDuration     Int?
  transcriptSync    String?   // JSON [{ start: seconds, text }] — line timings set by a reviewer for synchronized playback
  source            String
  yearCollected     Int?
  narrator          String?
  singer            String?
  communityLocation String
  province          String
  municipality      String
  barangay          String?

  // Classification fields (Suggested / Active)
  genre             String
  themes            String   // JSON array stored as string
  culturalElements  String   // JSON array stored as string

  // Human Verification Workflow fields
  reviewStatus        String    @default("PENDING") // "PENDING" | "VERIFIED" | "UNCERTAIN"
  verifiedGenre       String?
  verifiedThemes      String?   // JSON array stored as string
  reviewerId          String?
  reviewedAt          DateTime?
  verifiedAt          DateTime?
  reviewNotes         String?
  contentHash         String?   // SHA-256 hash of title, content, transcription, translation
  verifiedContentHash String?   // Hash when verification was confirmed

  // Metadata
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  createdBy         String?

  classifications   Classification[]
  reviews           ClassificationReview[]
}

model Classification {
  id               String          @id @default(cuid())
  entryId          String
  entry            LiteratureEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)

  classifiedGenre  String
  classifiedThemes String          // JSON array stored as string
  confidenceScore  Float
  rulesApplied     String          // JSON array stored as string
  predictionSource String          @default("RULE_BASED") // "RULE_BASED" | "ML_PIPELINE" | "HYBRID"
  modelVersion     String?
  probabilities    String?         // JSON map of class probabilities
  reviewStatus     String?
  timestamp        DateTime        @default(now())
}

model ClassificationReview {
  id               String          @id @default(cuid())
  entryId          String
  entry            LiteratureEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)

  suggestedGenre   String
  suggestedThemes  String?         // JSON array stored as string
  predictionSource String          @default("RULE_BASED")
  modelVersion     String?
  decision         String          // "CONFIRMED" | "CORRECTED" | "UNCERTAIN"
  approvedGenre    String?
  approvedThemes   String?         // JSON array stored as string
  reviewerId       String
  notes            String?
  contentHash      String
  createdAt        DateTime        @default(now())
}

model CategoryDefinition {
  id          String    @id @default(cuid())
  code        String    @unique // e.g. "MYTH", "LEGEND", "FOLKTALE", "EPIC", etc.
  type        String    // "GENRE" | "THEME"
  title       String
  framework   String    // "EUGENIO_1993" | "ANDRESS_1985"
  description String
  isDraft     Boolean   @default(false)
  approvedBy  String?
  approvedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model MLModelRegistry {
  id              String    @id @default(cuid())
  version         String    @unique // e.g. "v1.0.0", "v1.1.0", "rules-fallback"
  algorithm       String    // "LogisticRegression" | "LinearSVC" | "MultinomialNB" | "RuleBasedBaseline"
  status          String    @default("CANDIDATE") // "ACTIVE" | "ARCHIVED" | "REJECTED" | "CANDIDATE"
  metrics         String    // JSON string containing macroF1, perClass metrics, confusionMatrix
  macroF1         Float?
  accuracy        Float?
  datasetSize     Int       @default(0)
  verifiedCounts  String    @default("{}") // JSON record counts per category
  pipelinePath    String?   // Path to serialized scikit-learn artifact
  artifact        String?   // JSON model exported from the Colab trainer (vocabulary, IDF, coefficients)
  promotionReason String?
  activatedAt     DateTime?
  createdAt       DateTime  @default(now())
}

model MLTrainingJob {
  id                 String    @id @default(cuid())
  status             String    @default("PENDING") // "PENDING" | "RUNNING" | "COMPLETED" | "FAILED" | "SKIPPED"
  trigger            String    @default("MANUAL")  // "MANUAL" | "AUTO_THRESHOLD" | "SCHEDULED"
  datasetSize        Int       @default(0)
  newRecordsCount    Int       @default(0)
  candidateVersion   String?
  evaluationResults  String?   // JSON
  promotionDecision  String?   // "ACTIVATED" | "REJECTED_INFERIOR" | "REJECTED_INSUFFICIENT_DATA" | "SKIPPED_UNCHANGED"
  errorMessage       String?
  startedAt          DateTime  @default(now())
  completedAt        DateTime?
}

model ParallelTranslation {
  id           String   @id @default(cuid())
  english      String
  manobo       String
  bisaya       String
  category     String   @default("PHRASE") // "PHRASE" | "LEXICON" | "SENTENCE" | "CULTURAL"
  context      String?
  sourceRef    String?  // Reference to entry title or academic literature source
  literatureId String?
  isVerified   Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([english])
  @@index([manobo])
  @@index([bisaya])
}

model ClassifierSnapshot {
  id             String   @id @default(cuid())
  createdAt      DateTime @default(now())
  trainedSamples Int
  vocabularySize Int
  modelJson      String   // Serialized JSON of trained Naive Bayes, TF-IDF, and Char N-Gram models
  loocvJson      String   // Serialized JSON of out-of-sample LOOCV evaluation metrics
}

model TrainingCorpusDocument {
  id              String   @id // e.g. "tr-riddle-1"
  text            String
  genre           String   // MYTH | LEGEND | FOLKTALE | EPIC | RIDDLE | PROVERB | SONG | CHANT
  themes          String   @default("[]") // JSON array stored as string
  provenance      String
  source          String   // "archive-verbatim" | "author-written"
  citation        String?
  archiveEntryId  String?
  overlapsArchive Boolean  @default(false) // Duplicates an archive record; excluded from training to avoid leakage
  isActive        Boolean  @default(true)  // Disabled docs are kept for audit but not used for training
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([genre])
}

model LexiconEntry {
  id           String   @id @default(cuid())
  kind         String   // PHRASE | WORD | WEBONARY | DIALECT_VARIANT | PREFIX | SUFFIX
  manobo       String
  english      String?
  bisaya       String?
  tagalog      String?
  root         String?  // WEBONARY: root form; DIALECT_VARIANT: standard spelling
  partOfSpeech String?
  definition   String?
  notes        String?
  reference    String?  // e.g. source entry / verse reference for phrases
  entryTitle   String?
  group        String?  // Translator page vocabulary group (e.g. "Nature & Land")
  source       String?
  sortOrder    Int      @default(0)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([kind])
  @@index([manobo])
}

model ClassificationRule {
  id             String   @id // e.g. "G005" (genre), "T003" (theme), "L001" (location)
  name           String
  type           String   // GENRE | THEME | LOCATION
  framework      String   // EUGENIO_1993 | ANDRESS_1985 | PROVENANCE
  value          String   // genre / theme / location code
  keywords       String   @default("[]") // JSON array
  phrases        String   @default("[]") // JSON array
  contextClues   String   @default("[]") // JSON array
  baseConfidence Float    @default(0.8)
  source         String   @default("EXPERT") // EXPERT | EXPERT+DISCOVERED (terms approved from rule discovery)
  sortOrder      Int      @default(0)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([type])
}

model BarangayLocation {
  id           String   @id @default(cuid())
  barangay     String
  aliases      String   @default("[]") // JSON array of alternative spellings (e.g. "Sta Maria")
  municipality String
  province     String
  lat          Float
  lng          Float
  sourceUrl    String?  // e.g. PhilAtlas barangay profile used to verify the coordinates
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([barangay, municipality])
}

model BibleVerse {
  id       String @id // e.g. "MAT.5.3"
  book     String // USFM book code
  bookName String
  chapter  Int
  verse    Int
  text     String // verse text exactly as published (Kasuyatan to Diyus, © 1999 Wycliffe Bible Translators, CC BY-NC-ND)

  @@index([book, chapter])
}

model SystemManual {
  id            String   @id @default("active-manual")
  fileName      String
  fileSizeBytes String
  fileSize      Int
  mimeType      String   @default("application/pdf")
  pdfBase64     String   @db.Text
  title         String
  version       String   @default("1.0")
  updatedAt     DateTime @default(now()) @updatedAt
}


