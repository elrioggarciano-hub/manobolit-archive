{
  "name": "manobolit-archive",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "test": "ts-node -O \"{\\\"module\\\":\\\"commonjs\\\"}\" tests/integration.test.ts",
    "seed": "ts-node -e \"require('ts-node').register({module:'commonjs', compilerOptions:{allowJs:false}}); require('./prisma/seed.ts')\"",
    "seed:corpus": "ts-node -P tsconfig.scripts.json prisma/seedTrainingCorpus.ts",
    "seed:lexicon": "ts-node -P tsconfig.scripts.json prisma/seedLexicon.ts",
    "seed:rules": "ts-node -P tsconfig.scripts.json prisma/seedRules.ts",
    "eval": "ts-node -P scripts/evaluation/tsconfig.json scripts/evaluation/eval-loocv.ts",
    "eval:learning-curve": "ts-node -P scripts/evaluation/tsconfig.json scripts/evaluation/eval-learning-curve.ts",
    "eval:dataset": "ts-node -P scripts/evaluation/tsconfig.json scripts/evaluation/export-seed-dataset.ts",
    "eval:translation": "npm run eval:dataset && ts-node -P scripts/evaluation/tsconfig.json scripts/evaluation/eval-alignment.ts",
    "test:unit": "npm run eval:dataset && ts-node -P scripts/evaluation/tsconfig.json scripts/evaluation/test-sync.ts && ts-node -P scripts/evaluation/tsconfig.json scripts/evaluation/test-blend.ts",
    "notebook:build": "python -I scripts/evaluation/build_notebook.py"
  },
  "prisma": {
    "seed": "npm run seed"
  },
  "dependencies": {
    "@google/genai": "^3.3.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.8.0",
    "@supabase/supabase-js": "^2.48.0",
    "chart.js": "^4.5.1",
    "dotenv": "^17.4.2",
    "leaflet": "^1.9.4",
    "next": "^14.2.0",
    "pg": "^8.23.0",
    "prisma": "^7.8.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-leaflet": "^4.2.1"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.22",
    "@types/node": "^20.12.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.0",
    "eslint": "^8.57.0",
    "eslint-config-next": "^14.2.0",
    "postcss": "^8.4.0",
    "puppeteer": "^25.18.1",
    "puppeteer-core": "^25.18.1",
    "tailwindcss": "^3.4.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.0"
  }
}
