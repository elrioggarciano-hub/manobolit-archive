# PostgreSQL connection string for Supabase (Transaction Pooler - port 6543)
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:6543/postgres?pgbouncer=true"

# Direct connection string for Supabase migrations (Direct - port 5432)
DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"

# Supabase API Settings
NEXT_PUBLIC_SUPABASE_URL="https://[YOUR-PROJECT-REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="[YOUR-SUPABASE-ANON-KEY]"

# Admin panel login (protects /admin and write access to /api/entries, /api/classify)
ADMIN_PASSWORD="[CHOOSE-A-STRONG-PASSWORD]"
# Random secret used to sign admin session cookies, e.g. `openssl rand -hex 32`
SESSION_SECRET="[RANDOM-64-CHAR-HEX-STRING]"
